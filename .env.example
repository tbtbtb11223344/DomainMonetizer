# Local development only. Production values are Wrangler secrets/vars.
ENVIRONMENT=development
ALLOWED_ADMIN_EMAIL=operator@example.com
ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-aud
CONTROL_SHARED_SECRET=replace-with-a-long-random-secret
CODEX_RUNNER_SECRET=replace-with-an-independent-long-random-secret
OPERATOR_API_TOKEN=replace-with-an-independent-long-random-secret
PREVIEW_HOSTNAME=preview.multibrands.net
ALLOW_LOCAL_ADMIN=false
