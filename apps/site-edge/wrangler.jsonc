{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domain-monetizer-site-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "cache": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "preview.multibrands.net",
      "custom_domain": true
    },
    {
      "pattern": "mcneillsappliance.com",
      "custom_domain": true
    },
    {
      "pattern": "www.mcneillsappliance.com",
      "custom_domain": true
    },
    {
      "pattern": "heavenlyaircondition.com",
      "custom_domain": true
    },
    {
      "pattern": "www.heavenlyaircondition.com",
      "custom_domain": true
    },
    {
      "pattern": "phoenixroofcoating.net",
      "custom_domain": true
    },
    {
      "pattern": "www.phoenixroofcoating.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SITE_CONFIG",
      "id": "82bb4774d1814e26b87d1c50b2b5948c"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "domain_monetizer_events"
    }
  ],
  "services": [
    {
      "binding": "CONTROL",
      "service": "domain-monetizer-control"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
